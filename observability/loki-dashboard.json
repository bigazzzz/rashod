{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Grafana Cloud Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "uid": "porovnu-logs",
  "title": "Поровну · Логи Loki",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "links": [
    {"type": "link", "title": "Метрики", "url": "/d/porovnu-operations", "includeVars": false, "keepTime": true}
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "custom",
        "query": "web,mcp,caddy",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": "All", "value": "$__all"},
        "options": [
          {"text": "All", "value": "$__all", "selected": true},
          {"text": "web", "value": "web", "selected": false},
          {"text": "mcp", "value": "mcp", "selected": false},
          {"text": "caddy", "value": "caddy", "selected": false}
        ]
      },
      {
        "name": "pipeline",
        "label": "Фильтр LogQL",
        "description": "Укажите выражение после селектора, например | json | status >= 500. Пустое поле показывает все строки выбранных сервисов.",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""},
        "options": [{"text": "", "value": "", "selected": true}]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Логи",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "gridPos": {"h": 22, "w": 24, "x": 0, "y": 0},
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"porovnu\",service=~\"${service:regex}\"} ${pipeline:raw}",
          "editorMode": "code",
          "queryType": "range",
          "datasource": {"type": "loki", "uid": "${DS_LOKI}"}
        }
      ]
    }
  ]
}
