# Public domain Caddy serves and gets a TLS certificate for. Set this to your
# real domain (e.g. raskhod.app) once it's pointed at this server's IP —
# Caddy will automatically obtain a Let's Encrypt certificate for it. Leave
# unset (defaults to "localhost") for local testing: Caddy then serves HTTPS
# with its own self-signed local CA, which browsers will flag as untrusted —
# that's expected without a real domain.
DOMAIN=porovnu.su

# Overrides the host used when building shareable event links (share_url).
# Only needed if request-derived host/scheme is somehow still wrong even
# behind Caddy (e.g. a second proxy/tunnel in front of Caddy itself). Must
# start with http:// or https://. Leave unset otherwise.
PUBLIC_BASE_URL=https://example.com

# How many days an event (and its expenses) is kept before the background
# cleanup job deletes it. Must be a positive integer. Defaults to 365 if unset.
EVENT_RETENTION_DAYS=365

# TRUST_PROXY_HEADERS is intentionally not configurable here: the web
# container is only ever reachable through the Caddy container on the
# private compose network, so docker-compose.yml hardcodes it to "1".

# Where per-event AI OG backgrounds are stored (inside the container).
# Defaults to /data/og (on the same volume as the SQLite DB).
# OG_IMAGE_DIR=/data/og

# Optional MCP HTTP rate limit per client IP (requests per minute). Default 60.
# MCP_RATE_LIMIT_PER_MINUTE=60

# Set to 1 in production behind HTTPS (Caddy). Session cookie Secure flag.
# ADMIN_COOKIE_SECURE=1

# --- Secrets (NOT in this file) ---
# POLLINATIONS_API_KEY, OPS_TOKEN, MCP_TOKEN,
# ADMIN_PASSWORD, ADMIN_SESSION_SECRET live in secrets.enc.yaml (SOPS/age).
# Decrypt: ./scripts/sops-decrypt-env.sh  →  .env.secrets
# Edit:    SOPS_AGE_KEY_FILE=keys/age-dev.key sops secrets.enc.yaml
# Deploy:  keys/age-deploy.key on server only (not a personal age key)
# Docs:    docs/sops.md
# Admin:   docs/admin.md — both ADMIN_* required or /admin is 404.
